{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/check-hook.mjs\"",
        "powershell": "node \"${PLUGIN_ROOT}/check-hook.mjs\"",
        "timeoutSec": 60
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/check-hook.mjs\"",
        "powershell": "node \"${PLUGIN_ROOT}/check-hook.mjs\"",
        "timeoutSec": 30
      }
    ]
  }
}
